# HTTP server bind address and port
PORT=8080
LISTEN_ADDR=127.0.0.1:8080

# Public base URL of the app.
# - Local development: http://127.0.0.1:8080 (uses ATProto OAuth loopback mode)
# - Production:        https://heatmap.example.com (serves /oauth/client-metadata.json)
BASE_URL=http://127.0.0.1:8080

# Datastore backend: "postgres" (default) or "memory" (in-memory, resets on restart)
STORAGE=postgres

# PostgreSQL connection string (used when STORAGE=postgres)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/teal_heatmap?sslmode=disable

# Optional 64-char hex secret (at least 32 bytes). Auto-generated if omitted.
# SESSION_SECRET=
